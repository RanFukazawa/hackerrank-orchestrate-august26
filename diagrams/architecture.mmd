flowchart TD
    subgraph INPUT["Input"]
        MSG["messages.csv row\nmessage_id, user_id, conversation_type,\ngroup_id / business_id / sender_user_id,\ncreated_at, message_text, media_type, media_id, forwarded_count"]
    end

    subgraph CONTEXT["Context Loaders (loaders.py -- joined by ID into Dataset)"]
        USR["users.csv\nDND window, opens/replies/dismissals/reports 30d"]
        GRP["groups.csv + group_members.csv\ngroup type/size, user's role, read/reply/mute behavior"]
        BIZ["business_accounts.csv + user_business_history.csv\nverified, domain match, account age, opt-in/opt-out, order/booking history"]
    end

    subgraph MEDIA["Media Resolution (media.py)"]
        MTYPE{"media_type?"}
        IMGCSV["images.csv → file_path"]
        VNCSV["voice_notes.csv → file_path"]
        OCR["PytesseractOCREngine\nlocal tesseract OCR"]
        ASR["WhisperASREngine\nlocal faster-whisper ASR"]
        MEDIATEXT["derived_text\n(combined with message_text downstream)"]
    end

    subgraph RETRIEVAL["Evidence Retrieval (retrieval.py)"]
        HIST["message_history.csv\npast messages, filtered to same user_id"]
        EVENTS["message_events.csv\nopened/replied/dismissed/muted_after/reported per past message"]
        MATCH["EvidenceRetriever:\nidentity bonus (sender/group/business match)\n+ Jaccard token overlap on text\n(deterministic, dependency-free)"]
        EVID["top-2 EvidenceMatch\n(message_id, similarity, ReactionSummary)"]
    end

    subgraph RISK["Safety Guard (safety.py)"]
        SANITIZE["message_text + derived_text treated as DATA ONLY\n(injection attempts are a mute signal, never followed)"]
        SCAMRULES["SafetyGuard.detect_scam_signals:\nprompt_injection_attempt, credential_request,\nurgency_account_pressure, business_domain_mismatch\n(gated on NOT verified OR high report count),\nmarketing_spam_pattern"]
    end

    subgraph FEATBUILD["Feature Assembly (main.py build_features)"]
        FEATURES["FeatureBundle:\nmessage, user, group, membership,\nbusiness, biz_history, derived_text,\nevidence, safety"]
    end

    subgraph LLMOPT["Optional Model-Assist (llm.py, OFF by default)"]
        LLMGATE{"--use-llm flag set\nAND GEMINI_API_KEY present\nAND call budget remaining?"}
        LLMURGENCY["LLMReasoner.assess_urgency\ngemini-3.5-flash, thinking disabled\nadditive OR signal only"]
        LLMTYPE["LLMReasoner.classify_message_type\n(skipped on safety branch)"]
        LLMREASON["LLMReasoner.build_reason\n(skipped on safety branch)"]
    end

    subgraph DECISION["Decision Cascade (router.py RoutingEngine.route -- pure rules)"]
        RULE1{"SafetyResult.is_unsafe?"}
        RULE2{"group_muted_by_user OR\nnegative reaction pattern\nin evidence?"}
        RULE3{"urgency keywords OR\nbusiness status-update OR\nmodel says urgent (if enabled)\nAND is_trusted_sender?"}
        RULE4{"arrives during\nuser's DND window?"}
    end

    subgraph OUTPUT["Output (main.py write_output)"]
        ACTIONMUTE["action = mute\n(scam/spam/promotion/greeting/forward)"]
        ACTIONNOTIFY["action = notify\n(urgent/business_update)"]
        ACTIONDIGESTDEFERRED["action = digest\n(urgency deferred by quiet hours)"]
        ACTIONDIGEST["action = digest\n(default: safe, not urgent, no negative history)"]
        ROW["output.csv row:\nmessage_id, action, message_type,\nreason, confidence, evidence_message_ids"]
    end

    subgraph EVAL["Self-Evaluation (evaluation/main.py)"]
        SAMPLES["sample_messages.csv\n30 labeled rows"]
        SCORE["action / message_type accuracy,\nevidence hit rate\n(27/30 action, 90%, rules-only baseline)"]
    end

    MSG --> USR
    MSG --> GRP
    MSG --> BIZ
    MSG --> MTYPE

    MTYPE -->|image| IMGCSV --> OCR --> MEDIATEXT
    MTYPE -->|voice| VNCSV --> ASR --> MEDIATEXT
    MTYPE -->|none/text| MEDIATEXT

    MEDIATEXT --> SANITIZE
    MSG --> SANITIZE
    SANITIZE --> SCAMRULES

    MSG --> MATCH
    HIST --> MATCH
    EVENTS --> MATCH
    MATCH --> EVID

    USR --> FEATURES
    GRP --> FEATURES
    BIZ --> FEATURES
    EVID --> FEATURES
    SCAMRULES --> FEATURES
    MEDIATEXT --> FEATURES

    FEATURES --> RULE1
    RULE1 -->|yes| ACTIONMUTE
    RULE1 -->|no| RULE2
    RULE2 -->|yes| ACTIONMUTE
    RULE2 -->|no| LLMGATE
    LLMGATE -->|yes| LLMURGENCY
    LLMGATE -->|no| RULE3
    LLMURGENCY -.->|additive OR| RULE3
    RULE3 -->|no| ACTIONDIGEST
    RULE3 -->|yes| RULE4
    RULE4 -->|yes| ACTIONDIGESTDEFERRED
    RULE4 -->|no| ACTIONNOTIFY

    LLMGATE -.->|yes, non-safety branch| LLMTYPE
    LLMGATE -.->|yes, non-safety branch| LLMREASON
    LLMTYPE -.->|fallback to rule template on failure/None| ROW
    LLMREASON -.->|fallback to rule template on failure/None| ROW

    ACTIONMUTE --> ROW
    ACTIONNOTIFY --> ROW
    ACTIONDIGEST --> ROW
    ACTIONDIGESTDEFERRED --> ROW
    EVID -.-> ROW

    ROW -.-> SAMPLES
    SAMPLES --> SCORE
